# ============================================================
# Cipher Project — variáveis do backend de keys
#
# Modelo. Em produção, defina tudo em:
#   Vercel → Settings → Environment Variables → (depois Redeploy)
#
# Estas credenciais são do SEU Supabase novo (o das keys) — NADA a
# ver com o Supabase que a extensão usa para os recursos.
# ============================================================

# ---- Supabase (seu projeto novo) ----
# Project Settings → API → Project URL
SUPABASE_URL=
# Project Settings → API → service_role (Reveal). É SEGREDO: ignora o RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Painel de revenda ----
# Você inventa. Senha longa e aleatória. Quem tem ela gera keys ilimitadas.
CIPHER_ADMIN_TOKEN=

# ---- Opcional ----
# Link mostrado quando a key está presa em outro dispositivo
# (ex.: seu WhatsApp/Discord onde o cliente pede pra liberar o PC).
CIPHER_RESET_PAGE_URL=
